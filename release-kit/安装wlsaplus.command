#!/bin/bash
# 旧版「一键安装 DMG」脚本已停用。
# 2.0.0 起，同学请从源码编译：见同目录《说明书》或运行 编译wlsaplus.command
echo -ne "\033]0;WLSAPlus 安装说明\007"
echo "============================================"
echo "  WLSAPlus 2.0.0 不再使用本「DMG 一键安装」脚本"
echo "============================================"
echo ""
echo "请改用："
echo "  1) 双击同目录的 编译wlsaplus.command"
echo "  2) 或打开 wlsaplusmac版本说明书.md，按「从源码编译」操作"
echo ""
echo "推荐命令（国内镜像 gh-proxy.com；备选 ghproxy.net / ghfast.top）："
echo "  git clone https://gh-proxy.com/https://github.com/yezicheng2011/wlsaplus-enablemacos.git"
echo "  cd wlsaplus-enablemacos/native"
echo "  WLSAPLUS_VERSION=2.0.0 bash scripts/build.sh"
echo "  open out/WLSAPlus.app"
echo ""
echo "勿用常被墙的 ghproxy.com（无连字符）。"
echo ""
echo "© daniel.ye"
read -n 1 -s -r -p "按任意键关闭..."
echo ""
